---
import Site from '../../layouts/Site.astro';
import Archive from '../../components/Archive.astro';
import { posts, categories, categoryLabel } from '../../lib/posts.mjs';
export function getStaticPaths() { return categories.map((category) => ({ params: { category: category.toLowerCase() }, props: { category } })); }
const { category } = Astro.props;
const filtered = posts.filter((post) => post.categories.includes(category));
---
<Site title={categoryLabel(category)}><div class="page-heading"><a class="back-link" href="/">返回</a><h1>{categoryLabel(category)}</h1><p>{filtered.length} 篇文章</p></div><Archive posts={filtered} /></Site>
