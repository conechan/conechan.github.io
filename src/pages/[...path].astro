---
import Site from '../layouts/Site.astro';
import ArticleBody from '../components/ArticleBody.astro';
import { BackLink, AdjacentPostLink } from '../components/NavigationLinks';
import { posts, formatDate } from '../lib/posts.mjs';
export function getStaticPaths() { return posts.map((post, index) => ({ params: { path: post.path }, props: { post, previous: posts[index + 1], next: posts[index - 1] } })); }
const { post, previous, next } = Astro.props;
---
<Site title={post.title} description={post.description} article>
  <article>
    <header class="article-heading">
      <BackLink href={`/#y${post.year}`} />
      <h1>{post.title}</h1>
      <div class="article-meta"><time datetime={post.date}>{formatDate(post.date)}</time></div>
    </header>
    {post.headings.length >= 4 && <details class="article-toc"><summary>文章目录</summary><nav aria-label="文章目录"><ul>{post.headings.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav></details>}
    <ArticleBody parts={post.parts} />
  </article>
  <nav class="post-navigation" aria-label="相邻文章">
    <div>{previous && <AdjacentPostLink href={previous.url} label="上一篇" title={previous.title} />}</div>
    <div>{next && <AdjacentPostLink href={next.url} label="下一篇" title={next.title} />}</div>
  </nav>
</Site>
