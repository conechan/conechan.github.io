---
interface Props { path: string; title: string }
const { path, title } = Astro.props;
---
<section class="comments" data-pagefind-ignore data-comment-path={path} data-comment-title={title}>
  <button class="comments-toggle" type="button">查看原有评论</button>
  <p role="status">点击后加载 Disqus 评论。</p>
  <div id="disqus_thread"></div>
</section>
<script>
  interface DisqusConfig {
    page: { url: string; title: string };
    callbacks: { onReady: Array<() => void> };
  }
  const disqusWindow = window as Window & {
    disqus_config?: (this: DisqusConfig) => void;
    DISQUS?: { reset: (options: { reload: boolean; config: (this: DisqusConfig) => void }) => void };
  };
  document.querySelectorAll<HTMLElement>('[data-comment-path]').forEach((section) => {
    const button = section.querySelector('button');
    const message = section.querySelector('p');
    if (!button || !message) return;
    let loading = false;
    let ready = false;
    let script: HTMLScriptElement | undefined;
    let timeout: number | undefined;

    button.addEventListener('click', () => {
      if (loading || ready) return;
      loading = true;
      button.disabled = true;
      button.textContent = '正在加载评论…';
      message.textContent = '正在连接 Disqus…';
      section.setAttribute('aria-busy', 'true');

      const onReady = () => {
        window.clearTimeout(timeout);
        loading = false;
        ready = true;
        section.setAttribute('aria-busy', 'false');
        button.hidden = true;
        message.hidden = true;
      };
      const onError = () => {
        if (ready) return;
        window.clearTimeout(timeout);
        loading = false;
        section.setAttribute('aria-busy', 'false');
        button.disabled = false;
        button.textContent = '重试加载评论';
        message.textContent = '评论暂时无法加载，请检查网络后重试。';
      };
      const config = function (this: DisqusConfig) {
        // Keep the original thread URL so historical comments remain attached.
        this.page.url = `http://cone.cc${section.dataset.commentPath || '/'}`;
        this.page.title = section.dataset.commentTitle || '';
        this.callbacks.onReady = [onReady];
      };
      timeout = window.setTimeout(onError, 20000);
      disqusWindow.disqus_config = config;
      try {
        if (disqusWindow.DISQUS) {
          disqusWindow.DISQUS.reset({ reload: true, config });
        } else {
          script?.remove();
          script = document.createElement('script');
          script.src = 'https://conecc.disqus.com/embed.js';
          script.async = true;
          script.onerror = onError;
          document.body.append(script);
        }
      } catch {
        onError();
      }
    });
  });
</script>
